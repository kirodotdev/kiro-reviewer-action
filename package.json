{
  "name": "kiro-reviewer-action",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/bundle.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint src test scripts && prettier --check .",
    "format": "eslint --fix src test scripts && prettier --write ."
  },
  "dependencies": {
    "@smithy/core": "3.40.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node24": "24.0.6",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
